<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RealTimeChat by Tiago F.</title>
</head>
<body> 
    <h1>Login</h1>
    <form action="./register" method="POST">
        <label for="UserName">Username:</label><br>
        <input type="text" id="username" name="username" required pattern="[a-zA-Z0-9_]{3,}"><br><br>
        <label for="Password">Password:</label><br>
        <input type="password" id="password"  name="password" required pattern="[a-zA-Z0-9_]{3,}"><br><br>
        <input type="submit">
    </form>
    <h1>Register</h1>
    <form action="./register" method="POST">
        <label for="UserName">Username:</label><br>
        <input type="text" id="username" name="username" required pattern="[a-zA-Z0-9_]{3,}"><br><br>
        <label for="Password">Password:</label><br>
        <input type="password" id="password"  name="password" required pattern="[a-zA-Z0-9_]{3,}"><br><br>
        <input type="submit">
    </form>
    <p>Your password should be at least 8 characters long and include a mix of uppercase and lowercase letters, numbers, and special characters.</p>
</body>
</html>